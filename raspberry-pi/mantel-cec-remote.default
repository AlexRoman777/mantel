# Optional overrides for /etc/default/mantel-cec-remote.
MANTEL_CEC_SOURCE=libcec
MANTEL_CEC_LIBCEC_LOG_LEVEL=31
MANTEL_CEC_ACTIVATE_SOURCE=true
MANTEL_CEC_POWER_POLL_SECONDS=30
MANTEL_CEC_FOCUS_SHORTCUT=F12
MANTEL_CEC_INJECTOR=auto
MANTEL_CEC_CTL=/usr/bin/cec-ctl
MANTEL_CEC_STDBUF=/usr/bin/stdbuf
MANTEL_CEC_DEVICE=/dev/cec0
MANTEL_CEC_OSD_NAME=Mantel
MANTEL_CEC_CLIENT=/usr/bin/cec-client
MANTEL_CEC_WTYPE=/usr/bin/wtype
MANTEL_CEC_XDOTOOL=/usr/bin/xdotool
MANTEL_CEC_DEVICE_TYPE=p
MANTEL_CEC_DEBOUNCE_SECONDS=0.30
MANTEL_CEC_RESTART_SECONDS=3
MANTEL_CEC_LOG_LEVEL=INFO

<?xml version="1.0"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <keyboard>
    <keybind key="W-F12">
      <action name="ForEach">
        <query><identifier>chromium*</identifier></query>
        <then>
          <action name="Focus" />
          <action name="Raise" />
        </then>
      </action>
    </keybind>
    <keybind key="A-W-h">
      <action name="HideCursor" />
      <action name="WarpCursor" x="-1" y="-1" />
    </keybind>
  </keyboard>
</openbox_config>

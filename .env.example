# Copy to .env for local development. In Docker, pass these as environment variables.

# Base URL of your Immich server (no trailing slash), e.g. http://immich.local:2283
IMMICH_URL=

# Immich API key: create "Mantel read-only" with exactly album.read, asset.read,
# asset.view, face.read, memory.read, and person.read. See docs/IMMICH_API_KEY.md.
IMMICH_API_KEY=

# Optional
# PORT=3000
# CONTROL_PORT=3001
# DATA_DIR=./data
# TZ=Europe/Stockholm
# PLAYLIST_REFRESH_MINUTES=60
# IMAGE_CACHE_MAX_GB=20

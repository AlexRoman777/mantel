{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/routes/**/*",
    "src/hooks.server.ts",
    "server.js",
    "scripts/*.mjs",
    "scripts/*.js"
  ],
  "ignorePatterns": ["static/**", "build/**", ".svelte-kit/**"],
  "rules": {
    "unused-files": "error",
    "unused-exports": "warn",
    "unused-types": "warn",
    "circular-dependencies": "warn"
  }
}
